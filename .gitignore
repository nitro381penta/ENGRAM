# Local test exports and headset recordings
/CapturedMetrics/
/EngramRecall_*.json
/EngramZones_*.json
/EngramSpatialObjects.json
/OVR_CapturedMetrics/

# Third-party content restored locally by each developer
# Retain Unity .meta files for imported asset GUIDs, while excluding source files.
/Assets/Leohpaz/**
!/Assets/Leohpaz/**/
!/Assets/Leohpaz/**/*.meta
!/Assets/Leohpaz/*.meta

# Pretrained Ultralytics YOLO11s model weights (download/export separately)
# Keep *.onnx.meta tracked if present so Unity references can be restored.
**/yolo11s*.onnx
**/yolo11s*.sentis
**/yolo11s*.pt

# Secrets or signing files (if ever added)
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pem
*.key

# Keep Assets/, Packages/, ProjectSettings/, Images/ and their Unity .meta files.
# Do NOT blanket-ignore *.meta, *.asset, *.fbx, *.onnx, *.png or *.json.
# If the actual model file has a different name than yolo11s*.onnx, add its exact path here.

/.plastic/
